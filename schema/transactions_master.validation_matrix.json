{
  "schemaVersion": "2026-02-27.v1-draft",
  "table": "tblTransactionsMaster",
  "fieldRules": [
    {
      "field": "TransactionID",
      "required": true,
      "type": "text",
      "autoGenerated": true
    },
    {
      "field": "TxnDate",
      "required": true,
      "type": "date"
    },
    {
      "field": "Class",
      "required": true,
      "type": "enum"
    },
    {
      "field": "BusinessUnit",
      "requiredWhen": "Class == 'Business'",
      "type": "enum"
    },
    {
      "field": "Type",
      "required": true,
      "type": "enum"
    },
    {
      "field": "FromAccount",
      "required": true,
      "type": "enum"
    },
    {
      "field": "ToAccount",
      "requiredWhen": "Type in ['Transfer', 'Debt Repayment']",
      "type": "enum"
    },
    {
      "field": "Payee",
      "requiredWhen": "Type != 'Transfer'",
      "type": "text"
    },
    {
      "field": "CategoryCode",
      "required": true,
      "type": "text"
    },
    {
      "field": "CategoryName",
      "required": true,
      "type": "text"
    },
    {
      "field": "Member",
      "required": true,
      "type": "enum"
    },
    {
      "field": "Amount",
      "required": true,
      "type": "number",
      "minInclusive": 0.01
    },
    {
      "field": "TaxAmount",
      "required": true,
      "type": "number",
      "minInclusive": 0.0
    },
    {
      "field": "TaxFlag",
      "required": true,
      "type": "enum"
    },
    {
      "field": "HSTExempt",
      "required": true,
      "type": "bool-int"
    },
    {
      "field": "GeneralOfficeExpense",
      "required": true,
      "type": "bool-int"
    },
    {
      "field": "Shadow",
      "required": true,
      "type": "bool-int"
    },
    {
      "field": "BillClaimPct",
      "requiredWhen": "Type == 'Expense' and GeneralOfficeExpense == 0 and (Parent != '' or Client != '' or Matter != '')",
      "type": "number",
      "minInclusive": 0.0,
      "maxInclusive": 100.0
    },
    {
      "field": "TotalClaimAmount",
      "required": true,
      "type": "number",
      "calculated": "round((Amount + TaxAmount) * (BillClaimPct / 100.0), 2)"
    },
    {
      "field": "Status",
      "required": true,
      "type": "enum"
    },
    {
      "field": "VoidReason",
      "requiredWhen": "Status == 'Void'",
      "type": "text"
    },
    {
      "field": "ClearedAt",
      "requiredWhen": "Status in ['Cleared', 'Reconciled']",
      "type": "date"
    },
    {
      "field": "ReconciledAt",
      "requiredWhen": "Status == 'Reconciled'",
      "type": "date"
    },
    {
      "field": "CreatedAt",
      "required": true,
      "type": "datetime",
      "autoGenerated": true
    },
    {
      "field": "UpdatedAt",
      "required": true,
      "type": "datetime",
      "autoGenerated": true
    }
  ],
  "crossFieldRules": [
    {
      "id": "to_account_required_for_transfer_and_debt",
      "when": "Type in ['Transfer', 'Debt Repayment']",
      "assert": "ToAccount != ''",
      "severity": "error"
    },
    {
      "id": "different_accounts_on_movements",
      "when": "Type in ['Transfer', 'Debt Repayment']",
      "assert": "FromAccount != ToAccount",
      "severity": "error"
    },
    {
      "id": "debt_destination_account_type",
      "when": "Type == 'Debt Repayment'",
      "assert": "ToAccount.kind in ['credit-card', 'loc', 'mortgage', 'loan']",
      "severity": "error"
    },
    {
      "id": "hst_exempt_forces_zero_tax",
      "when": "HSTExempt == 1",
      "assert": "TaxAmount == 0",
      "severity": "warn"
    },
    {
      "id": "office_expense_not_billable",
      "when": "GeneralOfficeExpense == 1",
      "assert": "Parent == '' and Client == '' and Matter == '' and BillClaimPct in [0, 0.0]",
      "severity": "error"
    },
    {
      "id": "billable_expense_requires_context",
      "when": "Type == 'Expense' and BillClaimPct > 0",
      "assert": "Parent != '' and Client != '' and Matter != ''",
      "severity": "error"
    },
    {
      "id": "void_requires_reason",
      "when": "Status == 'Void'",
      "assert": "VoidReason != ''",
      "severity": "error"
    },
    {
      "id": "reconciled_requires_dates",
      "when": "Status == 'Reconciled'",
      "assert": "ClearedAt != '' and ReconciledAt != ''",
      "severity": "error"
    },
    {
      "id": "positive_amount",
      "when": "true",
      "assert": "Amount > 0",
      "severity": "error"
    }
  ]
}
